# Copy to .env and fill in. .env is gitignored; this template is not.

# Neo4j — required by neo4j_loader.py and retrieval.py.
# Use bolt:// for a local server, neo4j+s:// for an Aura instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant — optional, used by qdrant_loader.py and retrieval.py.
# Defaults to http://localhost:6333 when unset.
QDRANT_URL=http://localhost:6333
